<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CrimTube.UWP.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <ScrollViewer Padding="14,12,14,12">
        <StackPanel>
            <TextBlock Text="Инстанс" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="Приложение получает видео через инстанс: он сам проксирует поток, поэтому блокировка YouTube не мешает. Если один адрес не отвечает, приложение пробует остальные."
                       FontSize="12" TextWrapping="Wrap" Margin="0,4,0,8"
                       Foreground="{StaticResource MutedTextBrush}" />

            <TextBlock Text="Тип инстанса" FontSize="13" Margin="0,4,0,4" />
            <ComboBox x:Name="KindBox" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Invidious (проксирует видео)" />
                <ComboBoxItem Content="Piped" />
            </ComboBox>

            <TextBlock Text="Адрес (для Piped можно «api, proxy»)" FontSize="13" Margin="0,10,0,4" />
            <TextBox x:Name="InstanceBox" FontSize="14" InputScope="Url" />

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Сохранить" Click="OnSaveClick" />
                <Button Content="Проверить" Margin="8,0,0,0" Click="OnCheckClick" />
            </StackPanel>

            <TextBlock Text="Mux-сервер (необязательно)" FontSize="13" Margin="0,14,0,4" />
            <TextBox x:Name="ServerBox" FontSize="14" InputScope="Url"
                     PlaceholderText="http://192.168.31.50:8765" />
            <TextBlock Text="Если указан, качества 480p и выше скачиваются и склеиваются на сервере в один MP4 — звук не рассинхронизируется."
                       FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{StaticResource MutedTextBrush}" />

            <TextBlock Text="Обновления (URL latest.json)" FontSize="13" Margin="0,14,0,4" />
            <TextBox x:Name="UpdateBox" FontSize="14" InputScope="Url"
                     PlaceholderText="https://raw.githubusercontent.com/OWNER/REPO/main/latest.json" />
            <Button Content="Проверить обновления" Margin="0,6,0,0" Click="OnUpdateCheckClick" />

            <TextBlock x:Name="StatusText" Margin="0,8,0,0" FontSize="13"
                       TextWrapping="Wrap" Foreground="#FFE0A040" />

            <Grid Margin="0,18,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Готовые адреса" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button x:Name="PingAllButton" Grid.Column="1" Content="Пинговать все" Click="OnPingAllClick" />
            </Grid>

            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="76" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Адрес" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Grid.Column="1" Text="Пинг" FontSize="12" TextAlignment="Right"
                           Foreground="{StaticResource MutedTextBrush}" />
            </Grid>

            <ListView x:Name="PresetList" SelectionMode="None"
                      IsItemClickEnabled="True" ItemClick="OnPresetClick"
                      ScrollViewer.VerticalScrollMode="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="76" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="13"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding PingText}" FontSize="12"
                                       TextAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <Button Grid.Column="2" Content="Пинг" Margin="6,0,0,0"
                                    HorizontalAlignment="Right" Click="OnPingOneClick" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Margin="0,18,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="Если видео не открывается, обычно виноват сам инстанс: публичные серверы периодически падают или блокируются. Сохраните другой адрес из списка и нажмите «Проверить». Свой Invidious на домашнем сервере надёжнее всего." />

            <TextBlock Margin="0,18,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="#FF777777"
                       Text="CrimTube для Windows 10 Mobile • 0.4.7 • WTFPL" />
        </StackPanel>
    </ScrollViewer>
</Page>
