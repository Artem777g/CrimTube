<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="CrimTube.UWP.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF141414" />
            <SolidColorBrush x:Key="AccentRedBrush" Color="#FFCC2222" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#FF9A9A9A" />

            <DataTemplate x:Key="VideoItemTemplate">
                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="120" Height="68" Background="#FF222222">
                        <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                        <Border Background="#B0000000" CornerRadius="3" Padding="4,1"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4">
                            <TextBlock Text="{Binding LengthText}" FontSize="11" Foreground="White" />
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxLines="2"
                                   TextTrimming="CharacterEllipsis" FontSize="15" />
                        <TextBlock Text="{Binding Author}" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ViewsText}" Foreground="#FF777777" FontSize="12" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
