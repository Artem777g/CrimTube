<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CrimTube.UWP.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="12,10,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="Поиск видео" FontSize="15"
                     KeyDown="OnSearchKeyDown" />
            <Button Grid.Column="1" Content="Найти" Margin="8,0,0,0" Click="OnSearchClick" />
        </Grid>

        <ListView x:Name="VideoList" Grid.Row="1" Margin="12,4,12,0"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="OnVideoClick"
                  ItemTemplate="{StaticResource VideoItemTemplate}" />

        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="24"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" FontSize="14"
                   Foreground="{StaticResource MutedTextBrush}" />

        <ProgressBar x:Name="BusyBar" Grid.Row="2" Height="3" IsIndeterminate="True"
                     Visibility="Collapsed" />

        <CommandBar Grid.Row="3" IsOpen="False" Background="#FF1B1B1B">
            <AppBarButton Icon="Refresh" Label="Обновить" Click="OnRefreshClick" />
            <AppBarButton Icon="Setting" Label="Настройки" Click="OnSettingsClick" />
        </CommandBar>
    </Grid>
</Page>
