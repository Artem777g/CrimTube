<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#20242C" />
            <stroke android:width="2dp" android:color="#E53935" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#16181D" />
            <stroke android:width="1dp" android:color="#2A2E38" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
