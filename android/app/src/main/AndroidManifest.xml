<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.gohoski.notpipe" android:installLocation="auto">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-permission android:name="android.permission.STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application
        android:name=".NotPipe"
        android:banner="@drawable/tv_banner"
        android:allowBackup="true"
        android:icon="@drawable/main_icon"
        android:logo="@drawable/actionbar_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/main_icon"
        android:theme="@style/AppTheme">
        <activity
            android:name=".ModernMainActivity"
            android:label="@string/app_name"
            android:theme="@style/ModernTheme"
            android:windowSoftInputMode="stateHidden|adjustPan"
            android:exported="false" />
        <activity
            android:name=".ModernPlayerActivity"
            android:label="@string/app_name"
            android:theme="@style/ModernTheme"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false" />
        <activity
            android:name=".ModernHistoryActivity"
            android:theme="@style/ModernTheme"
            android:exported="false" />
        <activity
            android:name=".ModernDownloadsActivity"
            android:theme="@style/ModernTheme"
            android:exported="false" />
        <activity
            android:name=".ModernSubscriptionsActivity"
            android:theme="@style/ModernTheme"
            android:exported="false" />
        <activity
            android:name=".ModernSettingsActivity"
            android:theme="@style/ModernTheme"
            android:exported="false" />
        <activity
            android:name=".ModernWatchLaterActivity"
            android:theme="@style/ModernTheme"
            android:exported="false" />
        <activity
            android:name=".ModernAdvancedSettingsActivity"
            android:theme="@style/ModernTheme"
            android:exported="false" />
        <activity
            android:name=".TvMainActivity"
            android:label="@string/app_name"
            android:theme="@style/TvTheme"
            android:banner="@drawable/tv_banner"
            android:screenOrientation="landscape"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".TvSearchActivity"
            android:label="@string/tv_search"
            android:theme="@style/TvTheme"
            android:screenOrientation="landscape"
            android:exported="false" />
        <activity
            android:label="@string/app_name"
            android:name="io.github.gohoski.notpipe.MainActivity"
            android:configChanges="keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".HelpActivity"
            android:label="@string/help" />
        <activity android:name=".CrashActivity"
            android:label="@string/crash_title"
            android:excludeFromRecents="true" />
        <activity android:name=".SettingsActivity"
            android:label="@string/settings" />
        <activity android:name=".VideoActivity"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="www.youtube.com" />
                <data android:host="m.youtube.com" />
                <data android:host="youtube.com" />
                <data android:pathPrefix="/watch" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="youtu.be" />
            </intent-filter>
        </activity>
        <activity android:name=".ChannelActivity"
            android:label="@string/channel" />
        <activity android:name=".DownloadsActivity"
            android:label="@string/downloads" />
        <activity android:name=".SubscriptionsActivity"
            android:label="@string/subscriptions" />
        <activity android:name=".WatchLaterActivity"
            android:label="@string/watch_later" />
        <activity android:name=".HistoryActivity"
            android:label="@string/history" />
        <activity android:name=".InstancesActivity"
            android:label="@string/instances" />
        <activity android:name=".LocalVideoActivity"
            android:label="@string/player"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <service
            android:name=".download.DownloadService"
            android:exported="false" />
        <provider
            android:name=".UpdateProvider"
            android:authorities="io.github.gohoski.notpipe.updates"
            android:exported="false"
            android:grantUriPermissions="true" />
        <provider
            android:name=".download.DownloadsProvider"
            android:authorities="io.github.gohoski.notpipe.downloads"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
