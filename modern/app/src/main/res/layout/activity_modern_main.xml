<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0D10">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="18dp"
        android:paddingRight="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="14dp"
        android:layout_marginRight="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/modern_search_bg"
        android:paddingLeft="16dp"
        android:paddingRight="6dp">

        <EditText
            android:id="@+id/modern_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:hint="@string/modern_search_hint"
            android:textColor="#FFFFFF"
            android:textColorHint="#777D87"
            android:textSize="15sp"
            android:background="@android:color/transparent"
            android:singleLine="true"
            android:inputType="text" />

        <Button
            android:id="@+id/modern_search_go"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="@string/tv_search"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:background="@drawable/modern_chip_bg" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/modern_subscriptions"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:gravity="center"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:text="@string/subscriptions"
                android:textColor="#DDDDDD"
                android:textSize="12sp"
                android:background="@drawable/modern_chip_bg" />

            <TextView
                android:id="@+id/modern_history"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginLeft="8dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:gravity="center"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:text="@string/history"
                android:textColor="#DDDDDD"
                android:textSize="12sp"
                android:background="@drawable/modern_chip_bg" />

            <TextView
                android:id="@+id/modern_later"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginLeft="8dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:gravity="center"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:text="@string/watch_later"
                android:textColor="#DDDDDD"
                android:textSize="12sp"
                android:background="@drawable/modern_chip_bg" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <GridView
            android:id="@+id/modern_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="2"
            android:horizontalSpacing="12dp"
            android:verticalSpacing="12dp"
            android:padding="14dp"
            android:clipToPadding="false"
            android:stretchMode="columnWidth"
            android:listSelector="@android:color/transparent" />

        <ProgressBar
            android:id="@+id/modern_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/modern_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="#9AA0A6"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:background="@drawable/modern_nav_bg"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <TextView
            android:id="@+id/modern_nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Главная"
            android:textColor="#E53935"
            android:textSize="12sp"
            android:focusable="true"
            android:clickable="true" />

        <TextView
            android:id="@+id/modern_nav_downloads"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/downloads"
            android:textColor="#9AA0A6"
            android:textSize="12sp"
            android:focusable="true"
            android:clickable="true" />

        <TextView
            android:id="@+id/modern_nav_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/settings"
            android:textColor="#9AA0A6"
            android:textSize="12sp"
            android:focusable="true"
            android:clickable="true" />
    </LinearLayout>
</LinearLayout>
