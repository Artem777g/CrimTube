<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0D10">

    <!-- Верхняя панель: назад, название, качество -->
    <LinearLayout
        android:id="@+id/modern_player_top"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="4dp"
        android:paddingRight="12dp">

        <TextView
            android:id="@+id/modern_player_back"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:focusable="true"
            android:clickable="true" />

        <TextView
            android:id="@+id/modern_player_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/modern_player_quality"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:gravity="center"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:text="360p"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="@drawable/modern_chip_bg"
            android:focusable="true"
            android:clickable="true" />
    </LinearLayout>

    <!-- Видео: во всю ширину, соотношение 16:9 задаёт AspectRatioVideoView.
         Высота "wrap_content" позволяет кадру подстроиться под измеренную высоту видео. -->
    <FrameLayout
        android:id="@+id/modern_player_video_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000">

        <io.github.gohoski.notpipe.ui.TextureVideoView
            android:id="@+id/modern_player_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="#000000" />

        <ImageView
            android:id="@+id/modern_player_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:background="#000000"
            android:visibility="gone" />

        <TextView
            android:id="@+id/modern_player_poster_play"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="▶"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:background="@drawable/modern_chip_bg"
            android:visibility="gone"
            android:focusable="true"
            android:clickable="true" />

        <ProgressBar
            android:id="@+id/modern_player_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- Панель управления: -10, play, скорость, полный экран, +10 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <TextView
            android:id="@+id/modern_player_back10"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:text="-10 сек"
            android:textColor="#DDDDDD"
            android:textSize="12sp"
            android:background="@drawable/modern_chip_bg"
            android:focusable="true"
            android:clickable="true" />

        <TextView
            android:id="@+id/modern_player_play"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:text="▶"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="@drawable/modern_chip_bg"
            android:focusable="true"
            android:clickable="true" />

        <TextView
            android:id="@+id/modern_player_speed"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginLeft="8dp"
            android:minWidth="46dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:gravity="center"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:text="1×"
            android:textColor="#DDDDDD"
            android:textSize="12sp"
            android:background="@drawable/modern_chip_bg"
            android:focusable="true"
            android:clickable="true" />

        <TextView
            android:id="@+id/modern_player_fullscreen"
            android:layout_width="44dp"
            android:layout_height="38dp"
            android:layout_marginLeft="8dp"
            android:gravity="center"
            android:text="⛶"
            android:textColor="#DDDDDD"
            android:textSize="18sp"
            android:background="@drawable/modern_chip_bg"
            android:focusable="true"
            android:clickable="true" />

        <TextView
            android:id="@+id/modern_player_forward10"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:text="+10 сек"
            android:textColor="#DDDDDD"
            android:textSize="12sp"
            android:background="@drawable/modern_chip_bg"
            android:focusable="true"
            android:clickable="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/modern_player_playback_info"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:gravity="center_vertical"
        android:textColor="#9AA0A6"
        android:textSize="12sp"
        android:focusable="true"
        android:clickable="true" />

    <ScrollView
        android:id="@+id/modern_player_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="16dp">

            <!-- Карточка с метаданными и действиями -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/modern_card_bg"
                android:padding="12dp">

                <TextView
                    android:id="@+id/modern_player_views"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#9AA0A6"
                    android:textSize="11sp" />

                <!-- Канал: аватар, название, подписчики, кнопка подписки -->
                <LinearLayout
                    android:id="@+id/modern_player_channel_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:focusable="true"
                    android:clickable="true">

                    <ImageView
                        android:id="@+id/modern_player_channel_avatar"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:scaleType="centerCrop"
                        android:background="#20242C" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/modern_player_channel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/modern_player_subscribers"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="#9AA0A6"
                            android:textSize="11sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/modern_player_subscribe"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginLeft="8dp"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:gravity="center"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:text="@string/modern_player_subscribe"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:background="@drawable/modern_chip_bg"
                        android:focusable="true"
                        android:clickable="true"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Действия: нравится, не нравится, поделиться, скачать, позже -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/modern_player_like"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:gravity="center"
                            android:singleLine="true"
                            android:includeFontPadding="false"
                            android:text="@string/modern_player_like"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:background="@drawable/modern_chip_bg"
                            android:focusable="true"
                            android:clickable="true" />

                        <TextView
                            android:id="@+id/modern_player_dislike"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginLeft="8dp"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:gravity="center"
                            android:singleLine="true"
                            android:includeFontPadding="false"
                            android:text="@string/modern_player_dislike"
                            android:textColor="#DDDDDD"
                            android:textSize="12sp"
                            android:background="@drawable/modern_chip_bg"
                            android:focusable="true"
                            android:clickable="true" />

                        <TextView
                            android:id="@+id/modern_player_share"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginLeft="8dp"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:gravity="center"
                            android:singleLine="true"
                            android:includeFontPadding="false"
                            android:text="@string/modern_player_share"
                            android:textColor="#DDDDDD"
                            android:textSize="12sp"
                            android:background="@drawable/modern_chip_bg"
                            android:focusable="true"
                            android:clickable="true" />

                        <TextView
                            android:id="@+id/modern_player_download"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginLeft="8dp"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:gravity="center"
                            android:singleLine="true"
                            android:includeFontPadding="false"
                            android:text="@string/modern_player_download"
                            android:textColor="#DDDDDD"
                            android:textSize="12sp"
                            android:background="@drawable/modern_chip_bg"
                            android:focusable="true"
                            android:clickable="true" />

                        <TextView
                            android:id="@+id/modern_player_later"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginLeft="8dp"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:gravity="center"
                            android:singleLine="true"
                            android:includeFontPadding="false"
                            android:text="@string/modern_player_later_add"
                            android:textColor="#DDDDDD"
                            android:textSize="12sp"
                            android:background="@drawable/modern_chip_bg"
                            android:focusable="true"
                            android:clickable="true" />
                    </LinearLayout>
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/modern_player_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:ellipsize="end"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="8"
                    android:textColor="#BBBBBB"
                    android:textSize="13sp"
                    android:focusable="true"
                    android:clickable="true" />
            </LinearLayout>

            <!-- Вкладки: похожие / комментарии -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/modern_player_tab_related"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:text="@string/modern_player_related"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:background="@drawable/modern_chip_bg"
                    android:focusable="true"
                    android:clickable="true" />

                <TextView
                    android:id="@+id/modern_player_tab_comments"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginLeft="8dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:text="@string/modern_player_comments"
                    android:textColor="#9AA0A6"
                    android:textSize="13sp"
                    android:background="@drawable/modern_chip_bg"
                    android:focusable="true"
                    android:clickable="true" />
            </LinearLayout>

            <!-- Похожие видео -->
            <LinearLayout
                android:id="@+id/modern_player_related_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <ProgressBar
                    android:id="@+id/modern_player_related_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/modern_player_no_related"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:gravity="center"
                    android:text="@string/modern_player_no_related"
                    android:textColor="#9AA0A6"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <io.github.gohoski.notpipe.ui.AdapterLinearLayout
                    android:id="@+id/modern_player_related_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Комментарии -->
            <LinearLayout
                android:id="@+id/modern_player_comments_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/modern_player_comments_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/modern_player_no_comments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:gravity="center"
                    android:text="@string/modern_player_no_comments"
                    android:textColor="#9AA0A6"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <io.github.gohoski.notpipe.ui.AdapterLinearLayout
                    android:id="@+id/modern_player_comments_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/modern_player_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:textColor="#E0A040"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
