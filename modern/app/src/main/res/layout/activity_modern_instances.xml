<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0D10"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/modern_inst_back"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:focusable="true"
            android:clickable="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/modern_instances_title"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/modern_instances_type_label"
        android:textColor="#9AA0A6"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/modern_inst_tab_0"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginRight="4dp"
            android:background="@drawable/modern_chip_bg"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:focusable="true"
            android:clickable="true" />

        <TextView
            android:id="@+id/modern_inst_tab_1"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginRight="4dp"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:textColor="#9AA0A6"
            android:textSize="11sp"
            android:focusable="true"
            android:clickable="true" />

        <TextView
            android:id="@+id/modern_inst_tab_2"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginRight="4dp"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:textColor="#9AA0A6"
            android:textSize="11sp"
            android:focusable="true"
            android:clickable="true" />

        <TextView
            android:id="@+id/modern_inst_tab_3"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:textColor="#9AA0A6"
            android:textSize="11sp"
            android:focusable="true"
            android:clickable="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/modern_inst_input"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/modern_card_bg"
            android:gravity="center_vertical"
            android:hint="@string/modern_instances_hint"
            android:inputType="textUri"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#6B7280"
            android:textSize="14sp" />

        <Button
            android:id="@+id/modern_inst_add"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/modern_chip_bg"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="@string/modern_instances_add"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

        <Button
            android:id="@+id/modern_inst_ping"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="Пинг / диагностика"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:background="@drawable/modern_chip_bg" />

        <TextView
            android:id="@+id/modern_inst_ping_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#9AA0A6"
            android:textSize="12sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/modern_inst_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:id="@+id/modern_inst_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/modern_instances_empty"
            android:textColor="#9AA0A6"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <Button
        android:id="@+id/modern_inst_save"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/modern_chip_bg"
        android:text="@string/modern_instances_save"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp" />
</LinearLayout>
